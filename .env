# App Environment
ENV=development

# Security
SECRET_KEY=supersecretkeyreplaceinproduction1234567890

# Postgres container configuration (docker-compose uses these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothcrm

# Database Configuration (PostgreSQL)
# Inside docker the `web` service overrides this with host `db`.
# This value is for running the app locally from .venv against the docker DB:
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/clothcrm
