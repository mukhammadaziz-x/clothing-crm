# App Environment (development / production)
ENV=development

# Security
SECRET_KEY=supersecretkeyreplaceinproduction1234567890

# Postgres container configuration (docker-compose reads these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothcrm

# Database Configuration (PostgreSQL)
# Inside docker the `web` service overrides this to use host `db`.
# The value below is for running the app from .venv against the docker DB
# (compose publishes Postgres on host port 5435):
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/clothcrm
